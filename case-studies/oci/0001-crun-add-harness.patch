From cc27eaacfe7ab1b4939afbc53a0b41a6e3abbf42 Mon Sep 17 00:00:00 2001
From: Moritz Sanft <58110325+msanft@users.noreply.github.com>
Date: Mon, 28 Jul 2025 23:40:56 +0200
Subject: [PATCH] crun: add harness

Signed-off-by: Moritz Sanft <58110325+msanft@users.noreply.github.com>
---
 src/crun.c | 146 ++++++++++++++++++++++++++++++++++++++++++++---------
 1 file changed, 121 insertions(+), 25 deletions(-)

diff --git a/src/crun.c b/src/crun.c
index 3825577f..6bbca4c1 100644
--- a/src/crun.c
+++ b/src/crun.c
@@ -24,12 +24,21 @@
 #include <libgen.h>
 #include <errno.h>
 #include <limits.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <dirent.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <time.h>
+#include <sys/mount.h>
 
 #ifdef HAVE_DLOPEN
 #  include <dlfcn.h>
 #endif
 
 #include "crun.h"
+#include "libcrun/container.h"
 #include "libcrun/utils.h"
 #include "libcrun/custom-handler.h"
 #include "libcrun/status.h"
@@ -53,6 +62,7 @@
 #include "mounts.h"
 #include "restore.h"
 
+static libcrun_context_t crun_context;
 static struct crun_global_arguments arguments;
 
 static struct custom_handler_manager_s *handler_manager;
@@ -436,40 +446,126 @@ copy_args (char **argv, int argc)
   return buff;
 }
 
+void
+rand_str (char *buf, size_t len)
+{
+  static const char charset[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+  for (size_t i = 0; i < len; i++)
+    {
+      int key = rand () % (sizeof (charset) - 1);
+      buf[i] = charset[key];
+    }
+  buf[len] = '\0';
+}
+
+// recursively delete all files and directories in the given path
 int
-main (int argc, char **argv)
+rmdir_rec (char *path)
 {
-  libcrun_error_t err = NULL;
-  int ret, first_argument = 0;
+  // Try to unmount the directory if it is a mount point
+  // Ignore errors from umount, as it may not be a mount point
+  umount (path);
 
-  arguments.argc = argc;
-  arguments.argv = argv;
+  struct stat st;
+  if (lstat (path, &st) < 0)
+    return -1;
 
-#ifdef DYNLOAD_LIBCRUN
-  if (ensure_cloned_binary () < 0)
+  if (S_ISDIR (st.st_mode))
     {
-      fprintf (stderr, "Failed to re-execute libcrun via memory file descriptor\n");
-      _exit (EXIT_FAILURE);
+      DIR *dir = opendir (path);
+      if (! dir)
+        return -1;
+      struct dirent *entry;
+      while ((entry = readdir (dir)) != NULL)
+        {
+          if (strcmp (entry->d_name, ".") == 0 || strcmp (entry->d_name, "..") == 0)
+            continue;
+          char buf[PATH_MAX];
+          snprintf (buf, sizeof (buf), "%s/%s", path, entry->d_name);
+          if (rmdir_rec (buf) < 0)
+            {
+              closedir (dir);
+              return -1;
+            }
+        }
+      closedir (dir);
+      return rmdir (path);
     }
-  /* Resolve all libcrun weak dependencies.  */
-  if (dlopen ("libcrun.so", RTLD_GLOBAL | RTLD_DEEPBIND | RTLD_LAZY) == NULL)
-    error (EXIT_FAILURE, 0, "could not load `libcrun.so`: `%s`", dlerror ());
-#endif
+  else
+    {
+      return unlink (path);
+    }
+}
+
+int
+main (int argc, char **argv)
+{
+  if (argc != 2)
+    return 1;
+
+  srand (time (NULL));
+
+  while (__AFL_LOOP (10000))
+    {
+      mkdir ("rootfs", 0755);
+      mkdir ("rootfs/tmp", 0755);
+      mkdir ("rootfs/proc", 0755);
+      mkdir ("rootfs/sys", 0755);
+      mkdir ("rootfs/dev", 0755);
+      mkdir ("rootfs/dev/shm", 0755);
+
+      libcrun_error_t err = NULL;
+      cleanup_container libcrun_container_t *container = NULL;
+      int ret, first_argument = 0;
+
+      arguments.argc = argc;
+      arguments.argv = argv;
 
-  fill_handler_from_argv0 (argv[0], &arguments);
-  argp_parse (&argp, argc, argv, ARGP_IN_ORDER, &first_argument, &arguments);
+      fill_handler_from_argv0 (argv[0], &arguments);
+      argp_parse (&argp, argc, argv, ARGP_IN_ORDER, &first_argument, &arguments);
 
-  command = get_command (argv[first_argument]);
-  if (command == NULL)
-    libcrun_fail_with_error (0, "unknown command %s", argv[first_argument]);
+      crun_context.preserve_fds = 0;
+      crun_context.listen_fds = 0;
 
-  int command_argc = argc - first_argument;
-  cleanup_free char **command_argv = copy_args (argv + first_argument, command_argc);
-  command_argv[0] = argv[0];
+      char container_id[20];
+      rand_str (container_id, sizeof (container_id) - 1);
+
+      ret = init_libcrun_context (&crun_context, container_id, &arguments, &err);
+      if (UNLIKELY (ret < 0))
+        return ret;
 
-  ret = command->handler (&arguments, command_argc, command_argv, &err);
-  if (ret && err)
-    libcrun_fail_with_error (err->status, "%s", err->msg);
+      container = libcrun_container_load_from_file (argv[1], &err);
+      if (container == NULL)
+        libcrun_fail_with_error (0, "error loading config.json");
 
-  return ret;
+      ret = libcrun_container_create (&crun_context, container, 0, &err);
+      if (UNLIKELY (ret < 0))
+        {
+          libcrun_error_release (&err);
+          rmdir_rec ("rootfs");
+          return ret;
+        }
+
+      ret = libcrun_container_run (&crun_context, container, 0, &err);
+      if (UNLIKELY (ret < 0))
+        {
+          libcrun_error_release (&err);
+          rmdir_rec ("rootfs");
+          return ret;
+        }
+
+      ret = libcrun_container_kill (&crun_context, container->context->id, "SIGKILL", &err);
+      if (UNLIKELY (ret < 0))
+        {
+          libcrun_error_release (&err);
+          rmdir_rec ("rootfs");
+          return ret;
+        }
+
+      rmdir_rec ("rootfs");
+      libcrun_container_free (container);
+      container = NULL;
+    }
+
+  return 0;
 }
-- 
2.50.1

